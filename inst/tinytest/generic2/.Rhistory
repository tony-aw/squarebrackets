pre_subset_df <- tt_x
f_expect.data.frame <- function(x, row = NULL, col = NULL) {
rp <- parent.frame()$rp
if(!is.null(row)) row <- indx_x(row, x, rownames(x), nrow(x))
if(!is.null(col)) col <- indx_x(col, x, names(x), ncol(x))
if(any_empty_indices(row, col)) {
return(x)
}
if(is.null(row)) row <- seq_len(nrow(x))
if(is.null(col)) col <- seq_len(ncol(x))
row <- as.integer(row)
col <- as.integer(col)
x <- data.table::copy(x)
data.table::set(x, row, col, rp)
return(x)
}
f_out.data.frame <- function(x, row = NULL, col = NULL) {
rp <- parent.frame()$rp
out <- x
tt_mod(out, row, col, rp = rp)
return(out)
}
