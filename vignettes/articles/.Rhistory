x[-ind]
x[seq_len(100L)[-ind]]
n <- 1e5
x <- sample(1:1e5)
ind <- 10:(n - 10)
rcpp_invert_indices_int(ind, n)
collapse::funique(ind, sort = TRUE)
n <- 1e4
x <- sample(1:n)
ind <- 10:(n - 10)
rcpp_invert_indices_int(ind, n)
foo <- bench::mark(
base = x[-ind],
sb = x[seq_len(100L)[-ind]],
rcpp = x[rcpp_invert_indices_int(ind, n)],
clp_rcpp = x[collapse::funique(ind, sort = TRUE) |> rcpp_invert_indices_int(n)],
min_iterations = 100
)
foo <- bench::mark(
base = x[-ind],
sb = x[seq_len(n)[-ind]],
rcpp = x[rcpp_invert_indices_int(ind, n)],
clp_rcpp = x[collapse::funique(ind, sort = TRUE) |> rcpp_invert_indices_int(n)],
min_iterations = 100
)
summary(foo)
plot(foo)
