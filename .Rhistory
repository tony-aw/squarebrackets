}
// Check B: Duplicaten via C++ magie
if (!seen.insert(current).second) {
return Rf_ScalarInteger(i + 1); // Directe early-exit (1-based index)
}
}
// Alles is veilig: return 0
return Rf_ScalarInteger(0);
}
else if(TYPEOF(x) == INTSXP) {
// 2. Haal de lengte en de limiet op via de R C API
R_xlen_t n = Rf_xlength(x);
double limit = Rf_asReal(threshold);
// 3. De absolute topsnelheid: directe read-only C-pointer naar de data
const int *px = INTEGER_RO(x);
// 4. Reserveer direct de C++ hash-set
std::unordered_set<double> seen;
seen.reserve(n);
// 5. De ultrasnelle loop over de rauwe C-pointer
for (R_xlen_t i = 0; i < n; ++i) {
double current = px[i]; // <--- Dit is nu een directe geheugen-offset (bliksemsnel)
// Check A: Drempelwaarde
if (current > limit) {
return Rf_ScalarInteger(i + 1); // Directe early-exit (1-based index)
}
// Check B: Duplicaten via C++ magie
if (!seen.insert(current).second) {
return Rf_ScalarInteger(i + 1); // Directe early-exit (1-based index)
}
}
// Alles is veilig: return 0
return Rf_ScalarInteger(0);
}
else {
stop(\"unknown type given\");
}
}
"
Rcpp::cppFunction(code)
n <- 1e7
n <- 1e6
x <- sample(1:n)
foo <- bench::mark(
sb = squarebrackets:::.any_badindx(x, n) || anyDuplicated(x),
new = any_badindx2(x, n),
min_iterations = 100
)
code <- "
SEXP any_badindx2(SEXP x, SEXP threshold) {
if(TYPEOF(x) == REALSXP) {
// 2. Haal de lengte en de limiet op via de R C API
R_xlen_t n = Rf_xlength(x);
double limit = Rf_asReal(threshold);
// 3. De absolute topsnelheid: directe read-only C-pointer naar de data
const double* px = REAL_RO(x);
// 4. Reserveer direct de C++ hash-set
std::unordered_set<double> seen;
seen.reserve(n);
// 5. De ultrasnelle loop over de rauwe C-pointer
for (R_xlen_t i = 0; i < n; ++i) {
double current = px[i]; // <--- Dit is nu een directe geheugen-offset (bliksemsnel)
// Check A: Drempelwaarde
if (current > limit) {
return Rf_ScalarInteger(i + 1); // Directe early-exit (1-based index)
}
// Check B: Duplicaten via C++ magie
if (!seen.insert(current).second) {
return Rf_ScalarInteger(i + 1); // Directe early-exit (1-based index)
}
}
// Alles is veilig: return 0
return Rf_ScalarInteger(0);
}
else if(TYPEOF(x) == INTSXP) {
// 2. Haal de lengte en de limiet op via de R C API
R_xlen_t n = Rf_xlength(x);
double limit = Rf_asReal(threshold);
// 3. De absolute topsnelheid: directe read-only C-pointer naar de data
const int *px = INTEGER_RO(x);
// 4. Reserveer direct de C++ hash-set
std::unordered_set<double> seen;
seen.reserve(n);
// 5. De ultrasnelle loop over de rauwe C-pointer
for (R_xlen_t i = 0; i < n; ++i) {
double current = px[i]; // <--- Dit is nu een directe geheugen-offset (bliksemsnel)
// Check A: Drempelwaarde
if (current > limit) {
return Rf_ScalarLogical(1); // Directe early-exit (1-based index)
}
// Check B: Duplicaten via C++ magie
if (!seen.insert(current).second) {
return Rf_ScalarLogical(1); // Directe early-exit (1-based index)
}
}
// Alles is veilig: return 0
return Rf_ScalarLogical(0);
}
else {
stop(\"unknown type given\");
}
}
"
Rcpp::cppFunction(code)
n <- 1e6
x <- sample(1:n)
foo <- bench::mark(
sb = squarebrackets:::.any_badindx(x, n) || anyDuplicated(x),
new = any_badindx2(x, n),
min_iterations = 100
)
summary(foo)
plot(foo)
anyDuplicated(x)
squarebrackets:::.any_badindx(x, n)
